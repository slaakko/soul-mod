 <span xml:space="preserve">&nbsp;&nbsp;&nbsp;&nbsp;<span class="punctuation">(</span><span class="id">NUMBER</span><span class="punctuation">,</span>&nbsp;<span class="string">"number"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;<span class="punctuation">(</span><span class="id">VARIABLE</span><span class="punctuation">,</span>&nbsp;<span class="string">"variable"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;<span class="punctuation">(</span><span class="id">PI</span><span class="punctuation">,</span>&nbsp;<span class="string">"'pi'"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;<span class="punctuation">(</span><span class="id">PLUS</span><span class="punctuation">,</span>&nbsp;<span class="string">"+"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;<span class="punctuation">(</span><span class="id">MINUS</span><span class="punctuation">,</span>&nbsp;<span class="string">"-"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;<span class="punctuation">(</span><span class="id">TIMES</span><span class="punctuation">,</span>&nbsp;<span class="string">"*"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;<span class="punctuation">(</span><span class="id">DIVIDES</span><span class="punctuation">,</span>&nbsp;<span class="string">"/"</span><span class="punctuation">)</span><span class="punctuation">,</span>&nbsp;</span>
